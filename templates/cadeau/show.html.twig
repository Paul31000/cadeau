{% extends 'base.html.twig' %}

{% block title %}Cadeau{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-sm-9 p-3">
                <h1>Cadeau</h1>

                {# TODO dissocier pere noel de anniversaire #}
                <p>
                
                    Cher père noël, je souhaite un/une <strong>{{ cadeau.titre }}</strong>.&nbsp;
                    
                    {% if cadeau.urlRecomendee is not null %}
                        <a target="_blank" href="{{ cadeau.urlRecomendee }}">Cliquez ici pour voir le site proposant le cadeau.</a>&nbsp;
                    {% endif %}

                    Mes préférences pour le cadeau sont: 
                    <strong>{{ cadeau.taille ?? "Il n'y a pas de détails préférés" }}</strong>.&nbsp;
                    Le Cadeau vaut: <strong>{{cadeau.prix}}</strong>.&nbsp;

                    {% set montantCouvert = 0 %}
                    {% for utilisateurOffre in cadeau.utilisateurOffres %}
                        {% set montantCouvert = utilisateurOffre.montant + montantCouvert %}
                    {% endfor %}
                    Montant couvert <strong>{{montantCouvert}}</strong>.&nbsp;
                    Merci bon papa noël!!!
                </p>
                
                {% if not estDemandeur %}
                    <h2 class='pt-5'>Commentaires:</h2>
                    <div class="ps-1">
                        {{ render(controller('App\\Controller\\MessageController::index', {'idEntiteeLiee':cadeau.id, 'entiteeLiee':'cadeau'})) }} 

                        
                        <h3 class='pt-3'>Je poste un commentaire:</h3>
                        {{ render(controller('App\\Controller\\MessageController::new', {'idEntiteeLiee':cadeau.id, 'entiteeLiee':'cadeau'})) }} 
                    </div>

                    <h2 class='pt-5'>J'offre:</h2>
                    <div class="ps-1">
                        <h3 class=''>Utilisateurs offrant:</h3>
                        <ul>
                            {% if cadeau.utilisateurOffres|length > 0 %}
                                
                                {% for utilisateurOffre in cadeau.utilisateurOffres %}
                                    <li>{{utilisateurOffre.utilisateurConcerne.pseudo}}
                                        
                                        {% if utilisateurOffre.achete %}
                                            <div class="hover-show">
                                                {% include '/svgs/lock.svg.twig' %}
                                                <div class="hover">Cet utilisateur s'est designé comme responsable du cadeau.</div>
                                            </div>
                                        {% endif %}

                                    </li>
                                {% endfor %}

                            {% else %}
                                <li>Il n'y a pas encore de personnes offrant. Faites une proposition de prix.</li>
                            {% endif %}
                        </ul>

                        <h3 class='pt-3'>J'ai regardé le prix:</h3>
                        {{ render(controller('App\\Controller\\CadeauController::jairegarde', {'id':cadeau.id})) }} 

                        <h3 class='pt-3'>J'offre:</h3>
                        {{ render(controller('App\\Controller\\CadeauController::jePrends', {'id':cadeau.id})) }} 
                    </div>
                {% endif %}
                    {# TODO Je prends plus le cadeau #}
                    {# TODO dissocier les utilisateurs qui achetent des utilisateurs qui cotisent #}
                
            </div>

            <div class="col-12 col-lg-3 p-3">
                <h2>Cadeaux dans la liste de: {{cadeau.listeCadeau.utilisateur}}</h2>
                <ul>
                    {% for cadeau in cadeau.listeCadeau.cadeaux %}
                        <li>
                            <a href="{{ path('app_cadeau_show', {'id': cadeau.id}) }}">
                                {{cadeau.titre}} 
                            </a>
                            {% if cadeau.prix is not null %}
                                &nbsp;
                                ({{cadeau.prix}})
                            {% endif %}

                            {% for utilisateurOffre in cadeau.utilisateurOffres %}
                                {% if utilisateurOffre.achete %}
                                    <div class="hover-show">
                                        {% include '/svgs/lock.svg.twig' %}
                                        <div class="hover">{{utilisateurOffre.utilisateurConcerne.pseudo}} s'est designé comme responsable du cadeau.</div>
                                    </div>
                                {% endif %}
                            {% endfor %}
                            
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
{% endblock %}
