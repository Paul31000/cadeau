{% extends 'base.html.twig' %}

{% block title %}Cadeau{% endblock %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-sm-9 p-3">
                <h1>Cadeau</h1>

                {# TODO dissocier pere noel de anniversaire #}
                <p>
                
                    Cher père noël, je souhaite un/une <strong>{{ cadeau.titre }}</strong>.&nbsp;
                    <br>
                    {% if cadeau.urlRecomendee is not null %}
                        <a class="user-link" target="_blank" href="{{ cadeau.urlRecomendee }}">Cliquez ici pour voir le site proposant le cadeau.</a>&nbsp;
                    {% endif %}
                    Mes préférences de taille/couleur pour le cadeau sont: 
                    <strong>{{ cadeau.taille ?? "Il n'y a pas de taille préférée" }}</strong>.&nbsp;
                    Mes recommandations pour le cadeau sont: 
                    <strong>{{ cadeau.recommandations ?? "Il n'y a pas de recommandation" }}</strong>.&nbsp;
                    Le Cadeau vaut: <strong>{{cadeau.prix}}</strong>.&nbsp;

                    {% set montantCouvert = 0 %}
                    {% for utilisateurOffre in cadeau.utilisateurOffres %}
                        {% set montantCouvert = utilisateurOffre.montant + montantCouvert %}
                    {% endfor %}
                    Montant couvert <strong>{{montantCouvert}}</strong>.&nbsp;
                    Merci bon papa noël!!!
                </p>
                
                {% if not estDemandeur %}
                    <h2 class='pt-5'>Commentaires:</h2>
                    <div class="ps-1">
                        {{ render(controller('App\\Controller\\MessageController::index', {'idEntiteeLiee':cadeau.id, 'entiteeLiee':'cadeau'})) }} 

                        
                        <h3 class='pt-3'>Je poste un commentaire:</h3>
                        {{ render(controller('App\\Controller\\MessageController::new', {'idEntiteeLiee':cadeau.id, 'entiteeLiee':'cadeau'})) }} 
                    </div>

                    <h2 class='pt-5'>J'offre:</h2>
                    <div class="ps-1">
                        <h3 class=''>Utilisateurs offrant:</h3>
                        <ul>
                            {% if cadeau.utilisateurOffres|length > 0 %}
                                
                                {% for utilisateurOffre in cadeau.utilisateurOffres %}
                                    <li>{{utilisateurOffre.utilisateurConcerne.pseudo}}({{utilisateurOffre.montant}}e)
                                        
                                        {% if utilisateurOffre.achete %}
                                            <div class="hover-show">
                                                {% include '/svgs/lock.svg.twig' %}
                                                <div class="hover">Cet utilisateur s'est designé comme responsable du cadeau.</div>
                                            </div>
                                        {% endif %}

                                    </li>
                                {% endfor %}

                            {% else %}
                                <li>Il n'y a pas encore de personnes offrant. Faites une proposition de prix.</li>
                            {% endif %}
                        </ul>

                        <h3 class='pt-3'>J'ai regardé le prix:</h3>
                        {{ render(controller('App\\Controller\\CadeauController::jairegarde', {'id':cadeau.id})) }} 

                        <h3 class='pt-3'>Je participe:</h3>
                        {{ render(controller('App\\Controller\\CadeauController::jePrends', {'id':cadeau.id})) }} 
                    </div>
                {% endif %}
                    {# TODO Je prends plus le cadeau #}
                    {# TODO dissocier les utilisateurs qui achetent des utilisateurs qui cotisent #}
                
            </div>

            <div class="col-12 col-lg-3 p-3">
                <h2>Cadeaux dans la liste de: {{cadeau.listeCadeau.utilisateur}}</h2>
                <ul>
                    {% for cadeau in cadeau.listeCadeau.cadeaux %}
                        <li class="cadeau-link">
                            <a  href="{{ path('app_cadeau_show', {'id': cadeau.id}) }}">
                                {{cadeau.titre}} 
                            
                                {% set somme = 0 %}
                                {% if cadeau.prix is not null %}
                                    &nbsp;
                                    ({{cadeau.prix}})
                                {% endif %}

                                {% for utilisateurOffre in cadeau.utilisateurOffres %}
                                    {% set somme =  somme + utilisateurOffre.montant %}
                                    {% if utilisateurOffre.achete %}
                                        <div class="hover-show">
                                            {% include '/svgs/lock.svg.twig' %}
                                            <div class="hover">{{utilisateurOffre.utilisateurConcerne.pseudo}} s'est designé comme responsable du cadeau.</div>
                                        </div>
                                    {% endif %}
                                {% endfor %}
                                
                                {% if cadeau.prix is not null %}
                                    &nbsp;
                                    {% set pct = somme / cadeau.prix  %}
                                    {% if pct > 0 and pct < 0.08 %}
                                        <img class="cotise-svg" src="{{ asset('build/images/1n.png') }}" alt="cotise 1/12">
                                        <img class="cotise-svg-hover" src="{{ asset('build/images/1.png') }}" alt="cotise 1/12">
                                    {% elseif pct > 0.08 and pct < 0.16 %}
                                        <img class="cotise-svg" src="{{ asset('build/images/2n.png') }}" alt="cotise 2/12">
                                        <img class="cotise-svg-hover" src="{{ asset('build/images/2.png') }}" alt="cotise 2/12">
                                    {% elseif pct > 0.24 and pct < 0.32 %}
                                        <img class="cotise-svg" src="{{ asset('build/images/3n.png') }}" alt="cotise 3/12">
                                        <img class="cotise-svg-hover" src="{{ asset('build/images/3.png') }}" alt="cotise 3/12">
                                    {% elseif pct > 0.32 and pct < 0.4 %}
                                        <img class="cotise-svg" src="{{ asset('build/images/4n.png') }}" alt="cotise 4/12">
                                        <img class="cotise-svg-hover" src="{{ asset('build/images/4.png') }}" alt="cotise 4/12">
                                    {% elseif pct > 0.4 and pct < 0.48 %} 
                                        <img class="cotise-svg" src="{{ asset('build/images/5n.png') }}" alt="cotise 5/12">
                                        <img class="cotise-svg-hover" src="{{ asset('build/images/5.png') }}" alt="cotise 5/12">
                                    {% elseif pct > 0.48 and pct < 0.54 %}
                                        <img class="cotise-svg" src="{{ asset('build/images/6n.png') }}" alt="cotise 6/12">
                                        <img class="cotise-svg-hover" src="{{ asset('build/images/6.png') }}" alt="cotise 6/12">
                                    {% elseif pct > 0.54 and pct < 0.62 %}
                                        <img class="cotise-svg" src="{{ asset('build/images/7n.png') }}" alt="cotise 7/12">
                                        <img class="cotise-svg-hover" src="{{ asset('build/images/7.png') }}" alt="cotise 7/12">
                                    {% elseif pct > 0.62 and pct < 0.70 %}
                                        <img class="cotise-svg" src="{{ asset('build/images/8n.png') }}" alt="cotise 8/12">
                                        <img class="cotise-svg-hover" src="{{ asset('build/images/8.png') }}" alt="cotise 8/12">
                                    {% elseif pct > 0.70 and pct < 0.78 %}
                                        <img class="cotise-svg" src="{{ asset('build/images/9n.png') }}" alt="cotise 9/12">
                                        <img class="cotise-svg-hover" src="{{ asset('build/images/9.png') }}" alt="cotise 9/12">
                                    {% elseif pct > 0.78 and pct < 0.86 %}
                                        <img class="cotise-svg" src="{{ asset('build/images/10n.png') }}" alt="cotise 10/12">
                                        <img class="cotise-svg-hover" src="{{ asset('build/images/10.png') }}" alt="cotise 10/12">
                                    {% elseif pct > 0.86 and pct < 0.94 %}
                                        <img class="cotise-svg" src="{{ asset('build/images/11n.png') }}" alt="cotise 11/12">
                                        <img class="cotise-svg-hover" src="{{ asset('build/images/11.png') }}" alt="cotise 11/12">
                                    {% elseif pct > 0.94 %}
                                        <img class="cotise-svg" src="{{ asset('build/images/12n.png') }}" alt="cotise 12/12">
                                        <img class="cotise-svg-hover" src="{{ asset('build/images/12.png') }}" alt="cotise 12/12">
                                    {% endif %}                                               
                                {% endif %}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </div>
{% endblock %}
