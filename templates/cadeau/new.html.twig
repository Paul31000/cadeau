{% extends 'base.html.twig' %}

{% block title %}Nouveau cadeau{% endblock %}

{% block body %}
    <h1>Creer un nouveau cadeau pour votre liste du {{cadeau.listeCadeau.groupeCadeau.nomGroupe}}</h1>

    <br>

    <div class="container">
        <div class="row gx-5">
            <div class="col-12 col-xl-6">
                {{ include('cadeau/_form.html.twig') }}
            </div>
            <div class="col-8 col-xl-3">
                <h2>Cadeaux déjà présents:</h2>
                <ul>
                    {% for cadeau in listeCadeaux.cadeaux %}
                        {% if cadeau.id is not null %}
                            <li>
                                <a href="{{ path('app_cadeau_edit', {'id': cadeau.id}) }}">
                                    {{cadeau.titre}} 
                                </a>
                            </li>
                        {% endif %}
                    {% endfor %}
                </ul>
            </div>
            <div class="col-4 col-xl-3">
                <div class="rond-rouge">
                    {% include './svgs/cadeau.svg.twig' %}
                </div>
            </div>
        </div>
    </div>
    <br>


    

{% endblock %}
