{% extends 'base.html.twig' %}

{% block title %}Utilisateur {{ user.pseudo }}{% endblock %}

{% block body %}
    <h1>Utilisateur {{ user.pseudo }}</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Email</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>Pseudo</th>
                <td>{{ user.pseudo }}</td>
            </tr>
            <tr>
                <th>Adresse</th>
                <td>{{ user.adresse }}</td>
            </tr>
        </tbody>
    </table>

{% endblock %}
