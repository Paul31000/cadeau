{% extends 'base.html.twig' %}

{% block title %}{{ groupe_cadeau.nomGroupe }}{% endblock %}

{% block body %}

    

    <div class="container">
        <div class="row g-3">
            <div class="col-12 col-xl-12 d-flex justify-content-between p-3"> 
                <h1>Groupe cadeau {{ groupe_cadeau.nomGroupe }}</h1>
                <div class="d-flex">
                    <form class="pt-3 me-2" 
                        action="{{ url('app_liste_cadeau_new', {'id': groupe_cadeau.id}) }}" method="post">
                        <input  type="hidden" name="token" value="{{ csrf_token('app_liste_cadeau_new') }}"/>
                        <button class="" type="submit">Créer ou éditer ma liste de cadeaux</button>
                    </form>
                    <a class="button-link mt-3" href="{{ path('app_groupe_cadeau_edit', {'id': groupe_cadeau.id}) }}">Modifier le groupe</a>
                </div>

            </div>

            
            {% if groupe_cadeau is not null %}
                {% for listeCadeaux in groupe_cadeau.listeCadeaux %}
                    {% if listeCadeaux.utilisateur != app.user %}
                
                        <div class="col-12 col-sm-6 col-xl-3">
                            <h2>Liste de <a href="{{ path('app_user_show', {'id': listeCadeaux.utilisateur.id}) }}">{{listeCadeaux.utilisateur.pseudo}}</a></h2>
                            <ul>
                                {% for cadeau in listeCadeaux.cadeaux %}
                                    <li>
                                        <a href="{{ path('app_cadeau_show', {'id': cadeau.id}) }}">
                                            {{cadeau.titre}} 
                                            {% set somme = 0 %}
                                            {% for utilisateurOffre in cadeau.utilisateurOffres %}
                                                {% set somme =  somme + utilisateurOffre.montant %}
                                                {% if utilisateurOffre.achete %}
                                                    &nbsp;
                                                    <div class="hover-show">
                                                        {% include '/svgs/lock.svg.twig' %}
                                                        <div class="hover">{{utilisateurOffre.utilisateurConcerne.pseudo}} s'est designé comme responsable du cadeau.</div>
                                                    </div>
                                                {% endif %}
                                            {% endfor %}
                                            
                                            {% if cadeau.prix is not null %}
                                                &nbsp;
                                                {% set pct = somme / cadeau.prix  %}
                                                {% if pct > 0 and pct < 0.08 %}
                                                    <img class="cotise-svg" src="{{ asset('build/images/1.svg') }}" alt="cotise 1/12">
                                                {% elseif pct > 0.08 and pct < 0.16 %}
                                                    <img class="cotise-svg" src="{{ asset('build/images/2.svg') }}" alt="cotise 2/12">
                                                {% elseif pct > 0.24 and pct < 0.32 %}
                                                    <img class="cotise-svg" src="{{ asset('build/images/3.svg') }}" alt="cotise 3/12">
                                                {% elseif pct > 0.32 and pct < 0.4 %}
                                                    <img class="cotise-svg" src="{{ asset('build/images/4.svg') }}" alt="cotise 4/12">
                                                {% elseif pct > 0.4 and pct < 0.48 %} 
                                                    <img class="cotise-svg" src="{{ asset('build/images/5.svg') }}" alt="cotise 5/12">
                                                {% elseif pct > 0.48 and pct < 0.54 %}
                                                    <img class="cotise-svg" src="{{ asset('build/images/6.svg') }}" alt="cotise 6/12">
                                                {% elseif pct > 0.54 and pct < 0.62 %}
                                                    <img class="cotise-svg" src="{{ asset('build/images/7.svg') }}" alt="cotise 7/12">
                                                {% elseif pct > 0.62 and pct < 0.70 %}
                                                    <img class="cotise-svg" src="{{ asset('build/images/8.svg') }}" alt="cotise 8/12">
                                                {% elseif pct > 0.70 and pct < 0.78 %}
                                                    <img src="{{ asset('build/images/9.svg') }}" alt="cotise 9/12">
                                                {% elseif pct > 0.78 and pct < 0.86 %}
                                                    <img class="cotise-svg" src="{{ asset('build/images/10.svg') }}" alt="cotise 10/12">
                                                {% elseif pct > 0.86 and pct < 0.94 %}
                                                    <img class="cotise-svg" src="{{ asset('build/images/11.svg') }}" alt="cotise 11/12">
                                                {% elseif pct > 0.94 and pct < 1 %}
                                                    <img class="cotise-svg" src="{{ asset('build/images/12.svg') }}" alt="cotise 12/12">
                                                {% endif %}                                               
                                            {% endif %}
                                        </a>
                                    </li>
                                {% endfor %}
                            
                            </ul>
                        </div>

                    {% endif %}    

                {% endfor %}
            {% endif %}

        </div>
    </div>

{% endblock %}
