{% extends 'base.html.twig' %}

{% block title %}Groupe cadeau {{ groupe_cadeau.nomGroupe }}{% endblock %}

{% block body %}

    

    <div class="container">
        <div class="row g-3">
            <div class="col-12 d-flex justify-content-between p-3"> 
                <h1>Groupe cadeau {{ groupe_cadeau.nomGroupe }}</h1>
                <form class="pt-3" 
                    action="{{ url('app_liste_cadeau_new', {'id': groupe_cadeau.id}) }}" method="post">
                    <input  type="hidden" name="token" value="{{ csrf_token('app_liste_cadeau_new') }}"/>
                    <button class="vert" type="submit">Ecrire ma lettre à Santa</button>
                </form>
            </div>

            
            {% if groupe_cadeau is not null %}
                {% for listeCadeaux in groupe_cadeau.listeCadeaux %}
                    {% if listeCadeaux.utilisateur != app.user %}
                
                        <div class="col-3">
                            <h2>Liste de {{listeCadeaux.utilisateur.pseudo}}</h2>
                            <ul>
                                {% for cadeau in listeCadeaux.cadeaux %}
                                    <li>
                                        <a href="{{ path('app_cadeau_show', {'id': cadeau.id}) }}">
                                            {{cadeau.titre}} 
                                        </a>
                                        {{cadeau.prix}}€
                                    </li>
                                {% endfor %}
                            
                            </ul>
                        </div>

                    {% endif %}    

                {% endfor %}
            {% endif %}

        </div>
    </div>

{% endblock %}
