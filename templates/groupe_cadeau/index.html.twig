{% extends 'base.html.twig' %}

{% block title %}Groupe cadeau index{% endblock %}

{% block body %}
    <h1>Groupe cadeau index</h1>
    
    {# <a href="{{ path('app_groupe_cadeau_show', {'id': groupe_cadeaus.id}) }}">show</a> #}

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Type groupe</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for groupe_cadeau in groupe_cadeaus %}
            <tr>
                <td>{{ groupe_cadeau.id }}</td>
                <td>{{ groupe_cadeau.typeGroupe }}</td>
                <td>
                    <a href="{{ path('app_groupe_cadeau_show', {'id': groupe_cadeau.id}) }}">montrer</a>
                    <a href="{{ path('app_groupe_cadeau_edit', {'id': groupe_cadeau.id}) }}">editer</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">Il n'y a rien ici.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_groupe_cadeau_new') }}">Créer nouveau</a>
{% endblock %}
