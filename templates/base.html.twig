<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500;1,600;1,700&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Shafarik&display=swap" rel="stylesheet">
    </head>

    <body data-turbo="false" >
        <div class="container-fluid">
            <div class="row">
                <div class="col-xl-3"></div>
                <div class="col-12 col-xl-3 menu-gauche">
                    <div class="sub-menu-el">
                        <div class="d-flex justify-content-center py-5">
                            {% include '/svgs/304509.svg.twig' %}
                        </div>
                        {% if is_granted('IS_AUTHENTICATED_FULLY') %} 
                            <div>
                                {{ render(controller('App\\Controller\\IndexController::menu')) }} 
                            </div>
                        {% else %} 
                        <nav>
                            <ul class="d-flex flex-column">
                                <li class="liste">
                                Menu:
                                <ul>
                                        <li class="sous">
                                            <a href="{{ path('app_login') }}" class="mx-4">S'authentifier</a>
                                        </li>
                                        <li class="sous">
                                            <a href="{{ path('app_user_new') }}" class="mx-4">Créez votre compte</a>
                                        </li>
                                        <li class="sous">
                                            <a href="{{ path('app_forgot_password_request') }}" class="mx-4">Père noël un trou de mémoire...?</a>
                                        </li>
                                </ul>
                                </li>
                            </ul>
                        </nav>
                        {% endif %}
                    </div>
                </div>
                <div class="col-12 page-border"></div>
                <div class="col-12 col-xl-9 p-5 page-contenu">
                    {% block body %}{% endblock %}
                </div>
            </div>
        </div>
        
    </body>
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}<!-- Copy JavaScript from https://getbootstrap.com/docs/5.0/getting-started/introduction/#js -->
        {% endblock %}
</html>
